<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The app's one external host is api.typesafe.ai (jev, through CapacitorHttp); the WebView loads only
     https://localhost, which the app serves itself. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
